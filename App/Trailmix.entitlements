<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime exception for the microphone. Without it the runtime
         kills the process when AVAudioEngine opens the input device, whatever
         TCC says. Screen recording needs no counterpart: ScreenCaptureKit is
         gated by TCC alone.

         This is the entitlement set for a Developer ID / notarized build, which
         is not sandboxed. An App Store build additionally needs
         com.apple.security.app-sandbox, and with it the file-access
         entitlements to keep recordings outside the container. See Paths.swift
         and the Distribution section of STATUS.md. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
